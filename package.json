{
  "name": "mini-checkout-test-suite",
  "version": "1.0.0",
  "description": "Mini Checkout single-page application and comprehensive Playwright browser test suite",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "generate:evidence": "node scripts/capture-evidence.js"
  },
  "keywords": [
    "checkout",
    "playwright",
    "sdet",
    "testing",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
